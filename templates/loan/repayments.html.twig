{% extends 'base.html.twig' %}

{% block title %}My Repayments{% endblock %}
{% block page_title %}My Repayments{% endblock %}

{% block body %}
<div class="row mb-3">
    <div class="col-md-4">
        <div class="card text-white bg-primary">
            <div class="card-body d-flex align-items-center gap-3">
                <i class="bi bi-cash-stack fs-1"></i>
                <div>
                    <div class="small opacity-75">Total Paid</div>
                    <div class="fs-4 fw-bold">{{ totalPaid|number_format(2) }} TND</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-white bg-success">
            <div class="card-body d-flex align-items-center gap-3">
                <i class="bi bi-receipt-cutoff fs-1"></i>
                <div>
                    <div class="small opacity-75">Total Repayments</div>
                    <div class="fs-4 fw-bold">{{ rows|length }}</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4 d-flex align-items-center justify-content-end">
        <a href="{{ path('loan_index') }}" class="btn btn-outline-primary me-2">
            <i class="bi bi-list-ul me-1"></i> My Loans
        </a>
        <a href="{{ path('loan_dashboard') }}" class="btn btn-outline-secondary">
            <i class="bi bi-speedometer2 me-1"></i> Dashboard
        </a>
    </div>
</div>

{% if rows is empty %}
    <div class="card">
        <div class="card-body text-center py-5 text-muted">
            <i class="bi bi-calendar-x fs-1 d-block mb-3"></i>
            <h5>No repayments yet</h5>
            <p class="mb-0">Once you make repayments on a loan they will appear here.</p>
            <a href="{{ path('loan_index') }}" class="btn btn-primary mt-3">View My Loans</a>
        </div>
    </div>
{% else %}
    <div class="card shadow-sm">
        <div class="card-header">
            <h5 class="mb-0"><i class="bi bi-calendar-check me-2"></i>Repayment History</h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>#</th>
                            <th>Date</th>
                            <th>Loan</th>
                            <th>Type</th>
                            <th>Amount</th>
                            <th>Status</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for row in rows %}
                            {% set r = row.repayment %}
                            {% set loan = row.loan %}
                            <tr>
                                <td class="text-muted small">{{ loop.index }}</td>
                                <td>{{ r.paymentDate|date('d M Y') }}</td>
                                <td>
                                    <a href="{{ path('loan_show', {id: loan.id}) }}" class="fw-medium text-decoration-none">
                                        Loan #{{ loan.id }}
                                    </a>
                                    <div class="small text-muted">{{ loan.amount|number_format(2) }} TND total</div>
                                </td>
                                <td>
                                    <span class="badge bg-secondary">{{ r.paymentType|default('monthly')|capitalize }}</span>
                                </td>
                                <td class="fw-semibold text-success">{{ r.amount|number_format(2) }} TND</td>
                                <td>
                                    {% if r.status == 'paid' %}
                                        <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Paid</span>
                                    {% elseif r.status == 'pending' %}
                                        <span class="badge bg-warning text-dark"><i class="bi bi-hourglass-split me-1"></i>Pending</span>
                                    {% else %}
                                        <span class="badge bg-secondary">{{ r.status }}</span>
                                    {% endif %}
                                </td>
                                <td>
                                    <a href="{{ path('loan_show', {id: loan.id}) }}" class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                    <tfoot class="table-light">
                        <tr>
                            <th colspan="4" class="text-end">Total Paid</th>
                            <th class="text-success">{{ totalPaid|number_format(2) }} TND</th>
                            <th colspan="2"></th>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
{% endif %}
{% endblock %}
