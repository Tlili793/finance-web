<!DOCTYPE html>
<html>
<head>
    <style>
        body { font-family: sans-serif; line-height: 1.6; color: #333; margin: 0; padding: 0; }
        .container { max-width: 600px; margin: 0 auto; padding: 20px; border: 1px solid #eee; border-radius: 8px; }
        .header { background: #1a237e; color: white; padding: 20px; text-align: center; border-radius: 8px 8px 0 0; }
        .content { padding: 30px; }
        .footer { text-align: center; font-size: 12px; color: #777; padding: 20px; }
        .btn { display: inline-block; padding: 12px 24px; background: #1a237e; color: white; text-decoration: none; border-radius: 4px; font-weight: bold; margin-top: 20px; }
        .card { background: #f8fafc; padding: 15px; border-radius: 4px; margin: 20px 0; border-left: 4px solid #1a237e; }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h2>Insurance Portal</h2>
        </div>
        <div class="content">
            {% block content %}{% endblock %}
        </div>
        <div class="footer">
            &copy; {{ "now"|date("Y") }} MyFinance. All rights reserved.
        </div>
    </div>
</body>
</html>
