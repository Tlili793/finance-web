{% extends 'base.html.twig' %}
{% block title %}Admin — Contract Requests{% endblock %}
{% block page_title %}All Contract Requests{% endblock %}

{% block body %}
{% for label, messages in app.flashes %}
    {% for message in messages %}
        <div class="alert alert-{{ label }} alert-dismissible fade show">
            {{ message }}<button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endfor %}
{% endfor %}

<div class="card shadow-sm border-0">
    <div class="card-header bg-white py-3">
        <div class="d-flex justify-content-between align-items-center">
            <h3 class="card-title mb-0"><i class="bi bi-file-earmark-text me-2 text-primary"></i>Contract Requests</h3>
            <span class="badge bg-primary rounded-pill">{{ requests|length }} Total</span>
        </div>
    </div>
    <div class="card-body">
        <table id="adminRequestsTable" class="table table-hover align-middle mb-0" style="width:100%">
            <thead class="table-light">
                <tr>
                    <th>#</th>
                    <th>User</th>
                    <th>Asset</th>
                    <th>Package</th>
                    <th>Premium</th>
                    <th>Status</th>
                    <th>BoldSign Doc</th>
                    <th>Submitted</th>
                    <th class="text-center no-sort">Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for req in requests %}
                {% set statusClass = {
                    'PENDING':            'warning',
                    'WAITING_FOR_SIGNING':'info',
                    'APPROVED':           'success',
                    'SIGNED':             'primary',
                    'REJECTED':           'danger',
                    'CANCELLED':          'secondary'
                }[req.status] ?? 'secondary' %}
                <tr>
                    <td><span class="text-muted fw-bold">#{{ req.id }}</span></td>
                    <td>
                        <div class="d-flex align-items-center">
                            <div class="avatar-sm me-2 bg-light rounded-circle d-flex align-items-center justify-content-center" style="width:32px;height:32px">
                                <i class="bi bi-person text-secondary"></i>
                            </div>
                            <div>
                                <div class="fw-bold">{{ req.user.name }}</div>
                                <div class="small text-muted">{{ req.user.email }}</div>
                            </div>
                        </div>
                    </td>
                    <td>
                        <div class="fw-medium">{{ req.asset.reference }}</div>
                        <div class="small text-muted text-uppercase" style="font-size:0.7rem">{{ req.asset.type }}</div>
                    </td>
                    <td>{{ req.package.name }}</td>
                    <td><span class="fw-bold text-dark">{{ req.calculatedPremium }}</span> <small class="text-muted">TND</small></td>
                    <td><span class="badge rounded-pill text-bg-{{ statusClass }}">{{ req.status|replace({'_': ' '}) }}</span></td>
                    <td>
                        {% if req.boldsignDocumentId %}
                            <span class="badge bg-light text-dark font-monospace border" style="font-size:.7rem" title="{{ req.boldsignDocumentId }}">
                                <i class="bi bi-key-fill me-1 opacity-50"></i>{{ req.boldsignDocumentId|slice(0,8) }}…
                            </span>
                        {% else %}
                            <span class="text-muted small">N/A</span>
                        {% endif %}
                    </td>
                    <td data-sort="{{ req.createdAt ? req.createdAt|date('U') : 0 }}">
                        {{ req.createdAt ? req.createdAt|date('Y-m-d') : '—' }}
                    </td>
                    <td>
                        <div class="d-flex justify-content-center gap-1">
                            {# ── Approve / Reject: PENDING only ── #}
                            {% if req.status == 'PENDING' %}
                            <form method="post" action="{{ path('admin_insurance_request_approve', {id: req.id}) }}" class="d-inline">
                                <input type="hidden" name="_token" value="{{ csrf_token('approve-' ~ req.id) }}">
                                <button class="btn btn-sm btn-success" title="Approve & Send for Signing">
                                    <i class="bi bi-check-lg"></i>
                                </button>
                            </form>
                            <form method="post" action="{{ path('admin_insurance_request_reject', {id: req.id}) }}" class="d-inline"
                                   onsubmit="return confirm('Reject request #{{ req.id }}?')">
                                <input type="hidden" name="_token" value="{{ csrf_token('reject-' ~ req.id) }}">
                                <button class="btn btn-sm btn-warning" title="Reject">
                                    <i class="bi bi-x-lg"></i>
                                </button>
                            </form>
                            {% endif %}

                            {# ── Edit ── #}
                            <a href="{{ path('admin_insurance_request_edit', {id: req.id}) }}"
                               class="btn btn-sm btn-outline-primary" title="Edit">
                                <i class="bi bi-pencil"></i>
                            </a>

                            {# ── Delete ── #}
                            <form method="post" action="{{ path('admin_insurance_request_delete', {id: req.id}) }}" class="d-inline"
                                   onsubmit="return confirm('Permanently delete request #{{ req.id }}?')">
                                <button class="btn btn-sm btn-outline-danger" title="Delete">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script>
$(document).ready(function() {
    $('#adminRequestsTable').DataTable({
        "order": [[ 0, "desc" ]],
        "responsive": true,
        "pageLength": 10,
        "dom": '<"d-flex justify-content-between align-items-center mb-3"lf>rt<"d-flex justify-content-between align-items-center mt-3"ip>',
        "columnDefs": [
            { "targets": 'no-sort', "orderable": false }
        ],
        "language": {
            "searchPlaceholder": "Search requests...",
            "search": "",
            "lengthMenu": "_MENU_ per page"
        }
    });
});
</script>
{% endblock %}
