{% extends 'base.html.twig' %}

{% block title %}Dashboard{% endblock %}

{% block page_title %}Dashboard{% endblock %}

{% block body %}
<div class="bento-grid">

    {# Insurance #}
    <a href="{{ path('insurance_assets') }}" class="bento-card c-primary">
        <div class="card-arrow">↗</div>
        <div class="card-icon">
            <i class="bi bi-shield-check"></i>
        </div>
        <span class="card-label">Module</span>
        <span class="card-title">Insurance</span>
        <span class="card-sub">Manage policies &amp; assets</span>
    </a>

    {# Loans #}
    <a href="{{ path('loan_index') }}" class="bento-card c-success">
        <div class="card-arrow">↗</div>
        <div class="card-icon">
            <i class="bi bi-bank"></i>
        </div>
        <span class="card-label">Module</span>
        <span class="card-title">Loans &amp; repayments</span>
        <span class="card-sub">Track balances &amp; schedules</span>
    </a>

    {# Personal Finance #}
    <a href="{{ path('finance_budgets') }}" class="bento-card c-warning">
        <div class="card-arrow">↗</div>
        <div class="card-icon">
            <i class="bi bi-wallet2"></i>
        </div>
        <span class="card-label">Module</span>
        <span class="card-title">Personal finance</span>
        <span class="card-sub">Budgets, expenses &amp; bills</span>
    </a>

    {# Payments & Complaints #}
    <div class="split-card">
        <div class="split-header">
            <i class="bi bi-grid-1x2-fill"></i>
            Payments &amp; complaints
        </div>
        <a href="{{ path('payment_index') }}" class="split-row">
            <div class="split-icon" style="background:var(--info-light);color:var(--info);">
                <i class="bi bi-credit-card-2-front-fill"></i>
            </div>
            <div class="split-row-content">
                <span class="split-row-title">Payments</span>
                <span class="split-row-sub">View &amp; make payments</span>
            </div>
            <i class="bi bi-chevron-right split-chevron"></i>
        </a>
        <a href="{{ path('complaint_index') }}" class="split-row">
            <div class="split-icon" style="background:var(--danger-light);color:var(--danger);">
                <i class="bi bi-megaphone-fill"></i>
            </div>
            <div class="split-row-content">
                <span class="split-row-title">Complaints</span>
                <span class="split-row-sub">Submit &amp; track issues</span>
            </div>
            <i class="bi bi-chevron-right split-chevron"></i>
        </a>
    </div>

</div>

{# Recent Activity #}
<div class="activity-card">
    <div class="activity-header">
        <i class="bi bi-table"></i> Recent activity
    </div>
    <div class="activity-body">
        Welcome to your dashboard. Use the sidebar to navigate.
    </div>
</div>

{% endblock %}