{% extends 'base.html.twig' %}

{% block title %}Dashboard | MyFinance{% endblock %}

{% block stylesheets %}
<style>
    .hero-gradient {
        background: linear-gradient(135deg, #1a237e 0%, #3949ab 100%);
        border-radius: 1rem;
        color: white;
        padding: 2.5rem;
        margin-bottom: 2rem;
        position: relative;
        overflow: hidden;
        box-shadow: 0 10px 30px rgba(26, 35, 126, 0.2);
    }
    .hero-gradient::after {
        content: '';
        position: absolute;
        top: -50%;
        right: -10%;
        width: 300px;
        height: 300px;
        background: rgba(255, 255, 255, 0.1);
        border-radius: 50%;
    }
    .module-card {
        border: none;
        border-radius: 1.25rem;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        cursor: pointer;
        text-decoration: none !important;
        color: inherit !important;
        height: 100%;
        position: relative;
        overflow: hidden;
    }
    .module-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 15px 35px rgba(0,0,0,0.1) !important;
    }
    .icon-box {
        width: 54px;
        height: 54px;
        border-radius: 1rem;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        margin-bottom: 1.25rem;
    }
    .stat-badge {
        position: absolute;
        top: 1.5rem;
        right: 1.5rem;
        font-size: 0.8rem;
        padding: 0.4rem 0.8rem;
        border-radius: 50px;
        background: rgba(255,255,255,0.2);
        backdrop-filter: blur(4px);
    }
    .quick-action-btn {
        background: white;
        border: 1px solid #edf2f7;
        padding: 1rem;
        border-radius: 1rem;
        display: flex;
        align-items: center;
        gap: 1rem;
        transition: all 0.2s;
        text-decoration: none;
        color: #4a5568;
    }
    .quick-action-btn:hover {
        background: #f8fafc;
        border-color: #cbd5e0;
        transform: scale(1.02);
        color: #2d3748;
    }
</style>
{% endblock %}

{% block body %}
{# ── Hero Section ── #}
<div class="hero-gradient">
    <div class="row align-items-center">
        <div class="col-md-8">
            <h1 class="display-5 fw-bold mb-2">Welcome back, {{ app.user.name|default('User') }}!</h1>
            <p class="lead opacity-75 mb-0">Manage your assets, track your expenses, and secure your future all in one place.</p>
        </div>
        <div class="col-md-4 text-md-end d-none d-md-block">
            <i class="bi bi-wallet2 display-1 opacity-25"></i>
        </div>
    </div>
</div>

{# ── Main Modules ── #}
<div class="row g-4 mb-5">
    {# Insurance #}
    <div class="col-md-6 col-xl-3">
        <a href="{{ path('insurance_assets') }}" class="card module-card shadow-sm border-0">
            <div class="card-body p-4">
                <div class="icon-box bg-primary-subtle text-primary">
                    <i class="bi bi-shield-check"></i>
                </div>
                <h5 class="fw-bold mb-1">Insurance</h5>
                <p class="text-muted small mb-0">Secure your assets & track requests</p>
                <span class="stat-badge text-primary fw-bold">{{ assetCount }} Assets</span>
            </div>
        </a>
    </div>

    {# Loans #}
    <div class="col-md-6 col-xl-3">
        <a href="{{ path('loan_index') }}" class="card module-card shadow-sm border-0">
            <div class="card-body p-4">
                <div class="icon-box bg-success-subtle text-success">
                    <i class="bi bi-bank"></i>
                </div>
                <h5 class="fw-bold mb-1">Loans</h5>
                <p class="text-muted small mb-0">Manage borrowings & repayments</p>
                <span class="stat-badge text-success fw-bold">{{ loanCount }} Active</span>
            </div>
        </a>
    </div>

    {# Personal Finance #}
    <div class="col-md-6 col-xl-3">
        <a href="{{ path('finance_budgets') }}" class="card module-card shadow-sm border-0">
            <div class="card-body p-4">
                <div class="icon-box bg-warning-subtle text-warning">
                    <i class="bi bi-piggy-bank"></i>
                </div>
                <h5 class="fw-bold mb-1">Finances</h5>
                <p class="text-muted small mb-0">Control budgets & expenses</p>
                <span class="stat-badge text-warning fw-bold">Active</span>
            </div>
        </a>
    </div>

    {# Payments #}
    <div class="col-md-6 col-xl-3">
        <a href="{{ path('payment_index') }}" class="card module-card shadow-sm border-0">
            <div class="card-body p-4">
                <div class="icon-box bg-info-subtle text-info">
                    <i class="bi bi-credit-card"></i>
                </div>
                <h5 class="fw-bold mb-1">Payments</h5>
                <p class="text-muted small mb-0">History & instant transactions</p>
                <span class="stat-badge text-info fw-bold">{{ paymentCount }} Done</span>
            </div>
        </a>
    </div>
</div>

{# ── Quick Actions & AI Assistant ── #}
<div class="row g-4">
    <div class="col-lg-12">
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
            <div class="card-header bg-white border-0 py-3">
                <h5 class="fw-bold mb-0">Quick Actions</h5>
            </div>
            <div class="card-body p-4 pt-0">
                <div class="row g-3">
                    <div class="col-md-3">
                        <a href="{{ path('insurance_request_new') }}" class="quick-action-btn">
                            <i class="bi bi-plus-circle text-primary fs-4"></i>
                            <span>New Insurance Request</span>
                        </a>
                    </div>
                    <div class="col-md-3">
                        <a href="{{ path('loan_new') }}" class="quick-action-btn">
                            <i class="bi bi-cash-stack text-success fs-4"></i>
                            <span>Request a Loan</span>
                        </a>
                    </div>
                    <div class="col-md-3">
                        <a href="{{ path('payment_create') }}" class="quick-action-btn">
                            <i class="bi bi-send text-info fs-4"></i>
                            <span>Make a Payment</span>
                        </a>
                    </div>
                    <div class="col-md-3">
                        <a href="{{ path('complaint_new') }}" class="quick-action-btn">
                            <i class="bi bi-chat-left-dots text-danger fs-4"></i>
                            <span>Submit Complaint</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

{% endblock %}