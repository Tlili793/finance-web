<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<style>
    @page { margin: 0; }
    body { 
        font-family: 'Helvetica', 'Arial', sans-serif; 
        font-size: 11pt; 
        color: #333; 
        line-height: 1.6; 
        margin: 0;
        padding: 0;
    }
    .header-bar {
        background-color: #1a237e; /* Premium Dark Blue */
        height: 60px;
        width: 100%;
        margin-bottom: 40px;
    }
    .content {
        padding: 0 50px;
    }
    .title-section {
        border-bottom: 2px solid #1a237e;
        padding-bottom: 10px;
        margin-bottom: 30px;
    }
    h1 { 
        color: #1a237e; 
        font-size: 24pt; 
        margin: 0;
        text-transform: uppercase;
        letter-spacing: 2px;
    }
    .request-info {
        float: right;
        text-align: right;
        color: #666;
        font-size: 10pt;
    }
    .section-title {
        background-color: #f5f5f5;
        padding: 8px 12px;
        font-weight: bold;
        color: #1a237e;
        margin: 30px 0 15px 0;
        border-left: 4px solid #1a237e;
    }
    table { 
        width: 100%; 
        border-collapse: collapse; 
        margin-bottom: 20px; 
    }
    th { 
        text-align: left; 
        padding: 10px; 
        background-color: #fafafa;
        border-bottom: 1px solid #eee;
        width: 30%;
        color: #555;
    }
    td { 
        padding: 10px; 
        border-bottom: 1px solid #eee;
        font-weight: 500;
    }
    .terms-box {
        background-color: #fff;
        border: 1px solid #eee;
        padding: 20px;
        font-size: 10pt;
        color: #555;
        font-style: italic;
    }
    .footer {
        margin-top: 60px;
        border-top: 1px solid #eee;
        padding-top: 20px;
    }
    .signature-area {
        margin-top: 50px;
        width: 100%;
    }
    .signature-box {
        width: 250px;
        height: 80px;
        border: 2px dashed #1a237e;
        background-color: #f0f2ff;
        text-align: center;
        line-height: 80px;
        color: #1a237e;
        font-weight: bold;
        font-size: 12pt;
        border-radius: 4px;
        margin-top: 10px;
    }
    .clear { clear: both; }
</style>
</head>
<body>

<div class="header-bar"></div>

<div class="content">
    <div class="title-section">
        <div class="request-info">
            Contract ID: #{{ requestId }}<br>
            Issue Date: {{ "now"|date("d M Y") }}
        </div>
        <h1>Insurance Policy</h1>
    </div>

    <div class="section-title">POLICYHOLDER INFORMATION</div>
    <table>
        <tr>
            <th>Full Name</th>
            <td>{{ userName }}</td>
        </tr>
        <tr>
            <th>Policy Effective Date</th>
            <td>{{ contractDate }}</td>
        </tr>
    </table>

    <div class="section-title">INSURED ASSET DETAILS</div>
    <table>
        <tr>
            <th>Asset Reference</th>
            <td>{{ assetReference }}</td>
        </tr>
        <tr>
            <th>Coverage Plan</th>
            <td>{{ insurancePackage }}</td>
        </tr>
        <tr>
            <th>Premium Amount</th>
            <td style="color: #c62828; font-weight: bold;">{{ approvedValue }} TND</td>
        </tr>
    </table>

    <div class="section-title">DECLARATION & TERMS</div>
    <div class="terms-box">
        {{ terms }}
    </div>

    <div class="signature-area">
        <div style="float: left; width: 50%;">
            <p style="font-weight: bold; margin-bottom: 5px;">Insured Acceptance:</p>
            <div class="signature-box">[ SIGN HERE ]</div>
            <p style="font-size: 9pt; color: #777; margin-top: 5px;">{{ userName }}</p>
        </div>
        <div style="float: right; width: 40%; text-align: right; margin-top: 40px;">
            <p style="font-weight: bold;">Fintech Platform</p>
            <p style="font-size: 9pt; color: #777;">Authorized Digital Signature</p>
        </div>
        <div class="clear"></div>
    </div>

    <div class="footer">
        <p style="text-align: center; font-size: 9pt; color: #aaa;">
            This is a legally binding electronic document generated via BoldSign Secure Signature Service.
        </p>
    </div>
</div>

</body>
</html>